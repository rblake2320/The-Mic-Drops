# ── Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ── App ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# ── Database (local dev → docker-compose port 5433) ────────
DATABASE_URL="postgresql://micdrop:micdrop_dev@localhost:5433/micdrop"

# ── Redis (local dev → docker-compose port 6381) ───────────
REDIS_URL="redis://localhost:6381"

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string"
ADMIN_SECRET="change-this-admin-secret"

# ── Web Push (VAPID) — generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@yourapp.com"

# ── CORS — set to your Cloudflare Pages URL in production ──
CORS_ORIGIN="http://localhost:3000"

# ── Set to "true" when frontend is on Cloudflare Pages ─────
API_ONLY="false"
