    const { mau, conversionRate, cpmRate, creatorTakeRate } = inputs;

    const paidUsers = mau * (conversionRate / 100);
    const freeUsers = mau - paidUsers;

    // Monthly revenues
    const subscriptionRev = paidUsers * 9.99; // $9.99 monthly sub tier
    // 12 direct highly intentional drops with opt-in declared ads per free user per month
    const monthlyAdRev = freeUsers * (cpmRate / 1000) * 12; 
    const creatorAddOnRev = mau * 0.02; // SaaS monetization features: custom voice cloning, CRM hooks

    // Premium seasonal channels (Santa, Easter Bunny, plus B2B Enterprise syndications like News and Business)
    let enterpriseSaaSRev = 0;
    if (mau >= 3000000) {
      enterpriseSaaSRev = 550000; // Multi-brand accounts
    } else if (mau >= 300000) {
      enterpriseSaaSRev = 40000;
    } else {
      enterpriseSaaSRev = 0; // Pre-loaded default seasonal accounts only
    }

    const totalRevenue = subscriptionRev + monthlyAdRev + creatorAddOnRev + enterpriseSaaSRev;

    // Operating expenses (SaaS unit economics)
    const pushNotificationCost = mau * 0.012; // Onesignal/MobiLoud standard at scale
    
    // Bandwidth CDN delivery: heavy audio drops
    const cdnAudioCost = 1500 + (mau * 0.07);

    // Baseline database index, servers, caching nodes
    const infraBase = 3500;
    const infraVariable = mau * 0.022;
    const cloudInfrastructureCost = infraBase + infraVariable;

    // ElevenLabs enterprise custom models tier (cached common files, so we only generate dynamically per creator drop creation)
    const aiVoiceTtsCost = 250 + (mau * 0.0015);

    // Internal team salaries based on user-base step functions
    let engineeringSlariesCost = 28000;
    let productDesignCost = 5000;
    let marketingCacCost = 10000;
    let legalComplianceCost = 2500;
    let miscellaneousCost = 2000;

    if (mau > 1500000) {
      // High growth hiring tier: 45 engineers
      engineeringSlariesCost = 450000;
      productDesignCost = 75000;
      marketingCacCost = 350000;
      legalComplianceCost = 25000;
      miscellaneousCost = 35000;
    } else if (mau > 150000) {
      // Mid growth hiring tier: 10-12 engineers
      engineeringSlariesCost = 110000;
      productDesignCost = 18000;
      marketingCacCost = 75000;
      legalComplianceCost = 8000;
      miscellaneousCost = 6500;
    }

    // Stripe merchant gateway processing fees
    const stripeFees = (totalRevenue * 0.029) + (paidUsers * 0.30);

    const totalCosts = 
      pushNotificationCost + 
      cdnAudioCost + 
      cloudInfrastructureCost + 
      aiVoiceTtsCost + 
      engineeringSlariesCost + 
      productDesignCost + 
      marketingCacCost + 
      legalComplianceCost + 
      miscellaneousCost + 
      stripeFees;

    const netIncome = totalRevenue - totalCosts;
    const margin = totalRevenue > 0 ? (netIncome / totalRevenue) * 100 : 0;
    const arr = totalRevenue * 12;

    // Approximate break-even calculations
    const approxFixedCost = totalCosts - stripeFees - (mau * 0.02);
    const revPerUser = totalRevenue / mau;
    const breakEvenMAU = revPerUser > 0 ? approxFixedCost / revPerUser : 0;

    return {
      paidUsers,
      freeUsers,
      subscriptionRev,
      monthlyAdRev,
      creatorAddOnRev,
      enterpriseSaaSRev,
      totalRevenue,
      pushNotificationCost,
      cdnAudioCost,
      cloudInfrastructureCost,
      aiVoiceTtsCost,
      engineeringSlariesCost,
      productDesignCost,
      marketingCacCost,
      legalComplianceCost,
      miscellaneousCost,
      stripeFees,
      totalCosts,
      netIncome,
      margin,
      arr,
      breakEvenMAU
    };
  }, [inputs]);

  // Generate vector path coordinates for a clean preview line graph
  const chartCoordinates = useMemo(() => {
    // We compute 5 points across the scale from 50k to 6M MAU to plot the growth curves
    const points = [50000, 200000, 500000, 1500000, 3000000, 5000000];
    const { conversionRate, cpmRate } = inputs;

    return points.map(m => {
      const pUsers = m * (conversionRate / 100);
      const fUsers = m - pUsers;
      const subRev = pUsers * 9.99;
      const adRev = fUsers * (cpmRate / 1000) * 12;
      const addon = m * 0.02;
      
      let entRev = 0;
      if (m >= 3000000) entRev = 550000;
      else if (m >= 300000) entRev = 40000;

      const totalRev = subRev + adRev + addon + entRev;

      const pushCost = m * 0.012;
      const cdnCost = 1500 + (m * 0.07);
      const cloudCost = 3500 + m * 0.022;
      const ttsCost = 250 + (m * 0.0015);

      let engCost = 28000;
      let pdCost = 5000;
      let mktCost = 10000;
      let legCost = 2500;
      let miscCost = 2000;

      if (m > 1500000) {
        engCost = 450000;
        pdCost = 75000;
        mktCost = 350000;
        legCost = 25000;
        miscCost = 35000;
      } else if (m > 150000) {
        engCost = 110000;
        pdCost = 18000;
        mktCost = 75000;
        legCost = 8000;
        miscCost = 6500;
      }

      const strFees = (totalRev * 0.029) + (pUsers * 0.30);
      const totalCost = pushCost + cdnCost + cloudCost + ttsCost + engCost + pdCost + mktCost + legCost + miscCost + strFees;

      return {
        mau: m,
        revenue: totalRev,
        cost: totalCost
      };
    });
  }, [inputs.conversionRate, inputs.cpmRate]);

  // 12-Month Projected Growth Dataset
  const monthlyProjectionData = useMemo(() => {
    const { mau, conversionRate, cpmRate } = inputs;
    const months = [
      "Month 1", "Month 2", "Month 3", "Month 4", "Month 5", "Month 6",
      "Month 7", "Month 8", "Month 9", "Month 10", "Month 11", "Month 12"
    ];

    // Steady MoM compounding growth rate for the baseline (Aggressive: 6.5%)
    const MoMGrowthRate = 0.065;
    // Muted MoM compounding growth rate for conservative modeling
    const ConsMoMGrowthRate = 0.030;

    return months.map((month, index) => {
      // Aggressive model
      const monthMAU = Math.round(mau * Math.pow(1 + MoMGrowthRate, index));
      const subscribers = Math.round(monthMAU * (conversionRate / 100));
      const freeUsers = monthMAU - subscribers;

      // Revenue breakdown matching PnL formulas
      const subRev = subscribers * 9.99;
      const adRev = freeUsers * (cpmRate / 1000) * 12;
      const creatorAddOnRev = monthMAU * 0.02;

      let entRev = 0;
      if (monthMAU >= 3000000) {
        entRev = 550000;
      } else if (monthMAU >= 300000) {
        entRev = 40000;
      }

      const totalRevenue = subRev + adRev + creatorAddOnRev + entRev;

      // Conservative growth and metrics discount model
      const consConversionRate = conversionRate * 0.7; // 30% reduction in premium upgrade yield
      const consCpmRate = cpmRate * 0.8; // 20% lower CPM due to softer demand

      const consMonthMAU = Math.round(mau * Math.pow(1 + ConsMoMGrowthRate, index));
      const consSubscribers = Math.round(consMonthMAU * (consConversionRate / 100));
      const consFreeUsers = consMonthMAU - consSubscribers;

      const consSubRev = consSubscribers * 9.99;
      const consAdRev = consFreeUsers * (consCpmRate / 1000) * 12;
      const consCreatorAddOnRev = consMonthMAU * 0.015; // light engagement

      let consEntRev = 0;
      if (consMonthMAU >= 3000000) {
        consEntRev = 400000;
      } else if (consMonthMAU >= 300000) {
        consEntRev = 30000;
      }

      const consTotalRevenue = consSubRev + consAdRev + consCreatorAddOnRev + consEntRev;

      // Realistically simulated actual revenue incorporating deterministic monthly market fluctuations
      const pseudoRandomNoise = [
        0.91, // Month 1 (-9%)
        0.97, // Month 2 (-3%)
        1.04, // Month 3 (+4%)
        0.88, // Month 4 (-12%)
        1.02, // Month 5 (+2%)
        1.09, // Month 6 (+9%)
        0.95, // Month 7 (-5%)
        0.92, // Month 8 (-8%)
        1.01, // Month 9 (+1%)
        0.96, // Month 10 (-4%)
        1.11, // Month 11 (+11%)
        1.05  // Month 12 (+5%)
      ];
      const actualRevenue = Math.round(totalRevenue * pseudoRandomNoise[index] * (actualsModifier / 100));

      return {
        name: month,
        mau: monthMAU,
        subscribers: subscribers,
        subscribersK: parseFloat((subscribers / 1000).toFixed(1)),
        mauK: parseFloat((monthMAU / 1000).toFixed(1)),
        subRev: Math.round(subRev),
        adRev: Math.round(adRev),
        saasRev: Math.round(creatorAddOnRev + entRev),
        totalRevenue: Math.round(totalRevenue),
        actualRevenue,

        // Conservative trajectory exports
        consMau: consMonthMAU,
        consSubscribers: consSubscribers,
        consSubscribersK: parseFloat((consSubscribers / 1000).toFixed(1)),
        consMauK: parseFloat((consMonthMAU / 1000).toFixed(1)),
        consSubRev: Math.round(consSubRev),
        consAdRev: Math.round(consAdRev),
        consSaasRev: Math.round(consCreatorAddOnRev + consEntRev),
        consTotalRevenue: Math.round(consTotalRevenue)
      };
    });
  }, [inputs, actualsModifier]);

  // Segmented drill-down metrics for the selected month index
  const drilldownData = useMemo(() => {
    const data = monthlyProjectionData[selectedMonthIndex];
    if (!data) return [];
    return [
      { name: "Core Subscriptions", value: data.subRev, color: "#C19A6B", desc: "Premium tier memberships ($9.99/mo)" },
      { name: "Topic CPM Ads", value: data.adRev, color: "#8A9A86", desc: "Intentional zero-surveillance targeting" },
      { name: "Platform Creators & SaaS", value: data.saasRev, color: "#6E5A44", desc: "Enterprise licensing & voice features SaaS" }
    ];
  }, [monthlyProjectionData, selectedMonthIndex]);

  // Dynamic Investor Summary Metrics
  const summaryMetrics = useMemo(() => {
    // 1. Churn Probability (Monthly Churn Rate %):
    // Baseline churn is 4.0%.
    // Churn increases by 0.35% for every 1.0% conversion rate above 5% (representing churn among marginal premium signups).
    // Premium CPM rates represent high brand value and focus, reducing churn slightly by 0.15% per dollar above $5.00.
    const baseChurn = 0.040;
    const conversionPenalty = Math.max(0, inputs.conversionRate - 5) * 0.0035;
    const premiumCpmBonus = Math.max(0, inputs.cpmRate - 5) * 0.0015;
    
    // Bounds churn rate between 2.0% and 12.0%
    const churnRateVal = Math.max(0.02, Math.min(baseChurn + conversionPenalty - premiumCpmBonus, 0.12));
    
    // 2. Estimated CLV (Customer Lifetime Value):
    // CLV = Average Revenue Per Member ($9.99/mo) / Monthly Churn Rate.
    const clvVal = 9.99 / churnRateVal;

    // 3. Total Projected ARR (Annualized Run-Rate):
    // Based on the current slider inputs.
    const activeARR = pnl.arr;
    const month12ARR = monthlyProjectionData[11].totalRevenue * 12;

    return {
      churnProbability: churnRateVal * 100, // percentage representation, e.g. 4.25%
      estimatedCLV: clvVal,
      totalProjectedARR: activeARR,
      peakMonth12ARR: month12ARR
    };
  }, [inputs, pnl.arr, monthlyProjectionData]);

