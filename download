    setGrowthScenario("custom");
  };

  const applyBenchmark = (type: "seed" | "mid" | "high") => {
    setActiveBenchmark(type);
    setGrowthScenario("custom");
    if (type === "seed") {
      setInputs({
        mau: 50000,
        conversionRate: 5.0,
        cpmRate: 5.50,
        creatorTakeRate: 15.0
      });
    } else if (type === "mid") {
      setInputs({
        mau: 500000,
        conversionRate: 8.0,
        cpmRate: 9.00,
        creatorTakeRate: 15.0
      });
    } else if (type === "high") {
      setInputs({
        mau: 5000000,
        conversionRate: 12.0,
        cpmRate: 13.50,
        creatorTakeRate: 15.0
      });
