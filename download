  const breakEvenProj = useMemo(() => {
    let currentRevenue = beStartingRevenue;
    let currentOpex = beOpex;
    const revGrowth = beGrowthRate / 100;
    const opexGrowth = beOpexGrowthRate / 100;
    
    interface ProjMonth {
      monthIndex: number;
      dateStr: string;
      revenue: number;
      opex: number;
      netIncome: number;
      cumulativeBurn: number;
    }
    
    const projectionMonths: ProjMonth[] = [];
    const startDate = new Date(2026, 5, 12); // Start around currently localized date (June 2026)
    
    let breakEvenIndex = -1;
    let cumulativeBurn = 0;
    let peakFundingNeeded = 0;
    
    for (let m = 0; m < 36; m++) { // Project monthly for 3 full years (36 months)
      const date = new Date(startDate);
      date.setMonth(startDate.getMonth() + m);
      const dateStr = date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
      
      const netIncome = currentRevenue - currentOpex;
      if (netIncome < 0) {
        cumulativeBurn += Math.abs(netIncome);
        if (cumulativeBurn > peakFundingNeeded) {
          peakFundingNeeded = cumulativeBurn;
        }
      }
      
      projectionMonths.push({
        monthIndex: m,
        dateStr,
        revenue: Math.round(currentRevenue),
        opex: Math.round(currentOpex),
        netIncome: Math.round(netIncome),
        cumulativeBurn: Math.round(cumulativeBurn)
      });
      
      if (breakEvenIndex === -1 && currentRevenue >= currentOpex) {
        breakEvenIndex = m;
      }
      
      // Compound monthly growth
      currentRevenue = currentRevenue * (1 + revGrowth);
      currentOpex = currentOpex * (1 + opexGrowth);
    }
    
    const maxRevenue = Math.max(...projectionMonths.map(p => p.revenue));
    const maxOpex = Math.max(...projectionMonths.map(p => p.opex));
    const maxChartVal = Math.max(maxRevenue, maxOpex, 1000);
    
    return {
      projectionMonths,
      breakEvenIndex,
      beMonthName: breakEvenIndex !== -1 ? projectionMonths[breakEvenIndex].dateStr : "Never (within 36m)",
      monthsToBreakEven: breakEvenIndex !== -1 ? breakEvenIndex : -1,
      peakFundingNeeded: Math.round(peakFundingNeeded),
      finalMonthRevenue: projectionMonths[projectionMonths.length - 1].revenue,
      finalMonthOpex: projectionMonths[projectionMonths.length - 1].opex,
