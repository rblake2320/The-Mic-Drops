              {Array.from({ length: 12 }).map((_, idx) => (
                <button
                  key={idx}
                  onClick={() => setSelectedMonthIndex(idx)}
                  className={`py-1 transition-all cursor-pointer ${
                    selectedMonthIndex === idx
                      ? "bg-[#C19A6B] text-black font-bold font-mono"
                      : "text-slate-500 hover:text-white hover:bg-white/5"
                  }`}
                >
                  M{idx + 1}
                </button>
              ))}
            </div>

            {/* Split Pane Details */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
              {/* Left: Recharts Donut Pie Chart */}
              <div className="h-40 flex items-center justify-center relative bg-black border border-white/5 p-2">
                <ResponsiveContainer width="100%" height="100%">
                  <PieChart>
                    <Pie
                      data={drilldownData}
                      cx="50%"
                      cy="50%"
                      innerRadius={35}
                      outerRadius={55}
                      paddingAngle={3}
                      dataKey="value"
                    >
                      {drilldownData.map((entry, index) => (
                        <Cell key={`cell-${index}`} fill={entry.color} />
                      ))}
                    </Pie>
                    <Tooltip
                      formatter={(value: number) => [`$${value.toLocaleString()}`, "Revenue"]}
                      contentStyle={{
                        backgroundColor: "#000",
                        border: "1px solid rgba(255, 255, 255, 0.1)",
                        fontFamily: "monospace",
                        fontSize: "10px"
                      }}
                    />
                  </PieChart>
                </ResponsiveContainer>
                
                {/* Absolute text in the direct center of the donut */}
                <div className="absolute inset-x-0 top-[40%] text-center pointer-events-none">
                  <span className="text-[8px] text-slate-500 uppercase tracking-widest font-mono block">Total</span>
                  <span className="text-[10px] font-mono font-bold text-white block">
                    ${Math.round(
                      drilldownData.reduce((acc, curr) => acc + curr.value, 0)
                    ).toLocaleString()}
                  </span>
                </div>
              </div>

              {/* Right: Rich metric list and calculation breakdowns */}
              <div className="space-y-2.5">
                {drilldownData.map((seg, idx) => {
                  const totalVal = drilldownData.reduce((acc, curr) => acc + curr.value, 0);
                  const percentage = totalVal > 0 ? (seg.value / totalVal) * 100 : 0;
                  
                  return (
                    <div key={idx} className="bg-black border border-white/5 p-2 flex flex-col justify-between">
                      <div className="flex justify-between items-center text-[10px] font-mono">
                        <span className="flex items-center gap-1.5 text-white font-medium">
                          <span className="w-1.5 h-1.5" style={{ backgroundColor: seg.color }} />
                          {seg.name}
                        </span>
                        <span className="text-[#C19A6B] font-bold">
                          ${Math.round(seg.value).toLocaleString()} <span className="text-slate-500 font-normal text-[9px]">({percentage.toFixed(1)}%)</span>
                        </span>
                      </div>
                      <p className="text-[8px] text-slate-400 font-mono lowercase mt-0.5 leading-tight">
                        {seg.desc}
                      </p>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Dynamic Comparison Modal */}
      {isCompareModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
          {/* Backdrop Closer */}
          <div className="absolute inset-0 cursor-default" onClick={() => setIsCompareModalOpen(false)} />
          
          <div className="bg-[#090909] border border-white/10 w-full max-w-4xl p-6 flex flex-col max-h-[90vh] overflow-hidden rounded-none relative text-white shadow-2xl z-10 animate-in fade-in zoom-in-95 duration-200">
            {/* Header */}
            <div className="flex justify-between items-start border-b border-white/10 pb-4 mb-4">
              <div className="flex items-center gap-2.5">
                <Columns className="w-5 h-5 text-[#C19A6B]" />
                <div>
                  <h3 className="text-sm font-serif italic text-white tracking-wide">Strategic Comparison Terminal</h3>
                  <p className="text-[9px] font-mono uppercase tracking-widest text-[#C19A6B]">Variance Matrix & Strategy Performance Analysis</p>
                </div>
              </div>
              <button 
                onClick={() => setIsCompareModalOpen(false)}
                className="text-slate-500 hover:text-white transition-all p-1 bg-white/5 hover:bg-white/10"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Strategy Selectors */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5 bg-[#000] p-3 border border-white/5">
              <div>
                <label className="text-[8px] text-slate-500 font-mono uppercase tracking-wider block mb-1 font-bold">Strategy Source A (Baseline)</label>
                <select
                  value={scenarioAId}
                  onChange={(e) => setScenarioAId(e.target.value)}
                  className="bg-[#0C0C0C] border border-white/10 text-[10px] text-white font-mono rounded-none p-2 w-full outline-none focus:border-[#C19A6B]"
                >
                  {savedScenarios.map(s => (
                    <option key={s.id} value={s.id}>{s.name}</option>
                  ))}
                </select>
              </div>

              <div>
                <label className="text-[8px] text-slate-500 font-mono uppercase tracking-wider block mb-1 font-bold">Strategy Source B (Challenger)</label>
                <select
                  value={scenarioBId}
                  onChange={(e) => setScenarioBId(e.target.value)}
                  className="bg-[#0C0C0C] border border-white/10 text-[10px] text-white font-mono rounded-none p-2 w-full outline-none focus:border-[#C19A6B]"
                >
                  {savedScenarios.map(s => (
                    <option key={s.id} value={s.id}>{s.name}</option>
                  ))}
                </select>
              </div>
            </div>

            {/* Matrix comparison calculations */}
            {(() => {
              const scenarioA = savedScenarios.find(s => s.id === scenarioAId) || savedScenarios[0];
              const scenarioB = savedScenarios.find(s => s.id === scenarioBId) || savedScenarios[0];

              const perfA = getPnLAndKPIs(scenarioA.inputs);
              const perfB = getPnLAndKPIs(scenarioB.inputs);

              const renderVariance = (valA: number, valB: number, isCurrency = false, isPercent = false, invertFavorability = false) => {
                const diff = valB - valA;
                const percentChange = valA !== 0 ? (diff / valA) * 100 : 0;
                
                const isFavorable = invertFavorability ? diff < 0 : diff > 0;
                const isUnchanged = Math.abs(diff) < 0.0001;

                let formattedDiff = "";
                if (isCurrency) {
                  formattedDiff = (diff >= 0 ? "+" : "-") + formatCurrency(Math.abs(diff));
                } else if (isPercent) {
                  formattedDiff = (diff >= 0 ? "+" : "") + diff.toFixed(1) + "%";
                } else {
                  formattedDiff = (diff >= 0 ? "+" : "") + Math.round(diff).toLocaleString();
                }

                if (isUnchanged) {
                  return <span className="text-slate-500 font-mono text-[9px]">— Parity</span>;
                }

                return (
                  <div className="flex flex-col items-end">
                    <span className={`text-[10px] font-mono font-bold ${isFavorable ? "text-[#C19A6B]" : "text-[#F43F5E]"}`}>
                      {formattedDiff}
                    </span>
                    <span className={`text-[7.5px] font-mono ${isFavorable ? "text-[#C19A6B]/80" : "text-[#F43F5E]/80"}`}>
                      ({diff >= 0 ? "+" : ""}{percentChange.toFixed(1)}%)
                    </span>
                  </div>
                );
              };

              return (
                <div className="flex-1 overflow-y-auto space-y-4 pr-1">
                  {/* Summary Comparison cards */}
                  <div className="grid grid-cols-2 md:grid-cols-4 gap-2.5">
                    <div className="bg-[#0C0C0C] border border-white/5 p-2 px-3">
                      <span className="text-[7.5px] text-slate-400 font-mono uppercase tracking-wider block">ARR Difference</span>
                      <span className={`text-xs font-serif italic block mt-0.5 ${(perfB.arr - perfA.arr) >= 0 ? "text-[#C19A6B] font-bold" : "text-[#F43F5E] font-bold"}`}>
                        {formatCurrency(perfB.arr - perfA.arr)}
                      </span>
                      <span className="text-[7.5px] text-slate-500 font-mono uppercase block mt-1">
                        {perfA.arr !== 0 ? (((perfB.arr - perfA.arr) / perfA.arr) * 100).toFixed(1) : "0"}% shift
                      </span>
                    </div>

                    <div className="bg-[#0C0C0C] border border-white/5 p-2 px-3">
                      <span className="text-[7.5px] text-slate-400 font-mono uppercase tracking-wider block">Operating Cost Impact</span>
                      <span className={`text-xs font-serif italic block mt-0.5 ${(perfB.totalCosts - perfA.totalCosts) <= 0 ? "text-[#C19A6B] font-bold" : "text-[#F43F5E] font-bold"}`}>
                        {formatCurrency(perfB.totalCosts - perfA.totalCosts)}
                      </span>
                      <span className="text-[7.5px] text-slate-500 font-mono uppercase block mt-1">
                        cost variance index
                      </span>
                    </div>

                    <div className="bg-[#0C0C0C] border border-white/5 p-2 px-3">
                      <span className="text-[7.5px] text-slate-400 font-mono uppercase tracking-wider block">Margin Delta</span>
                      <span className={`text-xs font-serif italic block mt-0.5 ${(perfB.margin - perfA.margin) >= 0 ? "text-[#C19A6B] font-bold" : "text-[#F43F5E] font-bold"}`}>
                        {(perfB.margin - perfA.margin).toFixed(1)}%
                      </span>
                      <span className="text-[7.5px] text-slate-500 font-mono uppercase block mt-1">
                        point percentage delta
                      </span>
                    </div>

                    <div className="bg-[#0C0C0C] border border-white/5 p-2 px-3 col-span-2 md:col-span-1">
                      <span className="text-[7.5px] text-slate-400 font-mono uppercase tracking-wider block">CLV Variance</span>
                      <span className={`text-xs font-serif italic block mt-0.5 ${(perfB.estimatedCLV - perfA.estimatedCLV) >= 0 ? "text-[#C19A6B] font-bold" : "text-[#F43F5E]"}`}>
                        ${(perfB.estimatedCLV - perfA.estimatedCLV).toFixed(2)}
                      </span>
                      <span className="text-[7.5px] text-slate-500 font-mono uppercase block mt-1">
                        customer loyalty yield
                      </span>
                    </div>
                  </div>

                  {/* Matrix Detail Table */}
                  <div className="border border-white/5 bg-black overflow-hidden select-none">
                    <table className="w-full text-left font-mono text-[9px] border-collapse">
                      <thead>
                        <tr className="bg-[#0C0C0C] border-b border-white/10 uppercase tracking-widest text-[#C19A6B] text-[8px] font-bold">
                          <th className="p-2 pl-3">Lever Segment / Metric KPI</th>
                          <th className="p-2 text-right">A: {scenarioA.name}</th>
                          <th className="p-2 text-right">B: {scenarioB.name}</th>
                          <th className="p-2 text-right pr-3">Variance</th>
                        </tr>
                      </thead>
                      <tbody>
                        {/* INPUT LEVERS */}
                        <tr className="bg-white/[0.02] border-b border-white/5 select-none">
                          <td colSpan={4} className="p-2 pl-3 font-serif italic text-slate-400 font-semibold text-[10px]">Strategic Slider Inputs</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Monthly Active Users (MAU)</td>
                          <td className="p-2 text-right font-bold text-white">{scenarioA.inputs.mau.toLocaleString()}</td>
                          <td className="p-2 text-right font-bold text-white">{scenarioB.inputs.mau.toLocaleString()}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(scenarioA.inputs.mau, scenarioB.inputs.mau)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Premium Member Conversion</td>
                          <td className="p-2 text-right font-bold text-white">{scenarioA.inputs.conversionRate.toFixed(1)}%</td>
                          <td className="p-2 text-right font-bold text-white">{scenarioB.inputs.conversionRate.toFixed(1)}%</td>
                          <td className="p-2 text-right pr-3">{renderVariance(scenarioA.inputs.conversionRate, scenarioB.inputs.conversionRate, false, false)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Zero-Surveillance Ad CPM</td>
                          <td className="p-2 text-right font-bold text-white">${scenarioA.inputs.cpmRate.toFixed(2)}</td>
                          <td className="p-2 text-right font-bold text-white">${scenarioB.inputs.cpmRate.toFixed(2)}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(scenarioA.inputs.cpmRate, scenarioB.inputs.cpmRate, true)}</td>
                        </tr>

                        {/* OUTCOME REVENUES */}
                        <tr className="bg-white/[0.02] border-b border-white/5 select-none mt-4">
                          <td colSpan={4} className="p-2 pl-3 font-serif italic text-slate-400 font-semibold text-[10px]">Monthly Revenue Components</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Premium Memberships Revenues</td>
                          <td className="p-2 text-right text-[#C19A6B] font-bold">{formatCurrency(perfA.subscriptionRev)}</td>
                          <td className="p-2 text-right text-[#C19A6B] font-bold">{formatCurrency(perfB.subscriptionRev)}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.subscriptionRev, perfB.subscriptionRev, true)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Zero-Surveillance Ad Sales</td>
                          <td className="p-2 text-right text-white">{formatCurrency(perfA.monthlyAdRev)}</td>
                          <td className="p-2 text-right text-white">{formatCurrency(perfB.monthlyAdRev)}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.monthlyAdRev, perfB.monthlyAdRev, true)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Platform SaaS & Custom Models</td>
                          <td className="p-2 text-right text-white">{formatCurrency(perfA.creatorAddOnRev + perfA.enterpriseSaaSRev)}</td>
                          <td className="p-2 text-right text-white">{formatCurrency(perfB.creatorAddOnRev + perfB.enterpriseSaaSRev)}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.creatorAddOnRev + perfA.enterpriseSaaSRev, perfB.creatorAddOnRev + perfB.enterpriseSaaSRev, true)}</td>
                        </tr>

                        {/* OPERATIONS & MARGINS */}
                        <tr className="bg-white/[0.02] border-b border-white/5 select-none mt-4">
                          <td colSpan={4} className="p-2 pl-3 font-serif italic text-slate-400 font-semibold text-[10px]">Monthly Expenses & Performance Outcomes</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Total Operating Expenses (OpEx)</td>
                          <td className="p-2 text-right text-slate-450">{formatCurrency(perfA.totalCosts)}</td>
                          <td className="p-2 text-right text-slate-450">{formatCurrency(perfB.totalCosts)}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.totalCosts, perfB.totalCosts, true, false, true)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Net Operating Income</td>
                          <td className={`p-2 text-right font-bold ${perfA.netIncome >= 0 ? "text-emerald-450" : "text-rose-450"}`}>{formatCurrency(perfA.netIncome)}</td>
                          <td className={`p-2 text-right font-bold ${perfB.netIncome >= 0 ? "text-emerald-450" : "text-rose-450"}`}>{formatCurrency(perfB.netIncome)}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.netIncome, perfB.netIncome, true)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Net Profit Margin %</td>
                          <td className="p-2 text-right text-white font-bold">{perfA.margin.toFixed(1)}%</td>
                          <td className="p-2 text-right text-white font-bold">{perfB.margin.toFixed(1)}%</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.margin, perfB.margin, false, true)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Projected Run-rate (ARR)</td>
                          <td className="p-2 text-right text-white font-bold">{formatCurrency(perfA.arr)}</td>
                          <td className="p-2 text-right text-white font-bold">{formatCurrency(perfB.arr)}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.arr, perfB.arr, true)}</td>
                        </tr>

                        {/* COHORT RETENTION */}
                        <tr className="bg-white/[0.02] border-b border-white/5 select-none mt-4">
                          <td colSpan={4} className="p-2 pl-3 font-serif italic text-slate-400 font-semibold text-[10px]">Cohort Attrition & Life Span Value Metrics</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Monthly Churn Probability</td>
                          <td className="p-2 text-right text-slate-400">{perfA.churnProbability.toFixed(2)}%</td>
                          <td className="p-2 text-right text-slate-400">{perfB.churnProbability.toFixed(2)}%</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.churnProbability, perfB.churnProbability, false, true, true)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01] bg-[#0A0A0A]">
                          <td className="p-2 pl-4 text-slate-350">Customer Lifetime Value (CLV)</td>
                          <td className="p-2 text-right text-emerald-400 font-bold">${perfA.estimatedCLV.toFixed(2)}</td>
                          <td className="p-2 text-right text-emerald-400 font-bold">${perfB.estimatedCLV.toFixed(2)}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.estimatedCLV, perfB.estimatedCLV, true)}</td>
                        </tr>
                        <tr className="border-b border-white/5 hover:bg-white/[0.01]">
                          <td className="p-2 pl-4 text-slate-350">Raw Break-Even Scale (MAU)</td>
                          <td className="p-2 text-right text-slate-400">{Math.round(perfA.breakEvenMAU).toLocaleString()}</td>
                          <td className="p-2 text-right text-slate-400">{Math.round(perfB.breakEvenMAU).toLocaleString()}</td>
                          <td className="p-2 text-right pr-3">{renderVariance(perfA.breakEvenMAU, perfB.breakEvenMAU, false, false, true)}</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>

                  {/* Strategic evaluation note */}
                  <div className="bg-[#101010] border border-white/5 p-3 rounded-none text-[8.5px] text-slate-400 leading-normal">
                    <p className="font-mono uppercase text-[#C19A6B] text-[7.5px] font-bold mb-1">PROCTOR ADVISORY NOTE:</p>
                    {perfB.netIncome - perfA.netIncome > 100000 ? (
                      <span>
                        Challenger Strategy (B) optimizes monetization pathways significantly, showing strong bottom-line expansion. Ensure customer acquisition investments scale linearly to offset increased cash operational needs.
                      </span>
                    ) : perfA.netIncome - perfB.netIncome > 100000 ? (
                      <span>
                        Baseline Strategy (A) displays higher net income performance. Challenger (B) may carry high structural AI caching or system delivery costs that compress yields despite top-line scaling.
                      </span>
                    ) : (
                      <span>
                        Strategies yield similar bottom-line margins. Select the target blueprint that represents lower subscriber conversion friction or lower transactional processing burden.
                      </span>
                    )}
                  </div>
                </div>
              );
            })()}

            {/* Modal Controls */}
            <div className="flex justify-end gap-3 border-t border-white/10 pt-4 mt-4">
              <button
                onClick={() => {
                  const scenarioA = savedScenarios.find(s => s.id === scenarioAId) || savedScenarios[0];
                  handleLoadScenario(scenarioA.inputs);
                  setIsCompareModalOpen(false);
                }}
                className="px-3.5 py-1.5 border border-white/20 text-white font-mono hover:bg-white/5 text-[9px] uppercase tracking-wider transition-all cursor-pointer"
              >
                [Apply A to Sliders]
              </button>
              <button
                onClick={() => {
                  const scenarioB = savedScenarios.find(s => s.id === scenarioBId) || savedScenarios[0];
                  handleLoadScenario(scenarioB.inputs);
                  setIsCompareModalOpen(false);
                }}
                className="px-3.5 py-1.5 border border-[#C19A6B] text-[#C19A6B] font-mono hover:bg-[#C19A6B]/5 text-[9px] uppercase tracking-wider transition-all cursor-pointer"
              >
                [Apply B to Sliders]
              </button>
              <button
                onClick={() => setIsCompareModalOpen(false)}
                className="px-4 py-1.5 bg-[#C19A6B] text-black font-mono font-bold text-[9px] uppercase tracking-wider hover:bg-[#A98458] transition-all cursor-pointer"
              >
                [Close]
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
