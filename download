export function getPnLAndKPIs(inputs: FinancialInputs) {
  const { mau, conversionRate, cpmRate } = inputs;

  const paidUsers = mau * (conversionRate / 100);
  const freeUsers = mau - paidUsers;

  // Monthly revenues
  const subscriptionRev = paidUsers * 9.99; // $9.99 monthly sub tier
  // 12 direct highly intentional drops with opt-in declared ads per free user per month
  const monthlyAdRev = freeUsers * (cpmRate / 100) * 12; // Wait, CPM in previous file is (cpmRate / 1000) * 12 or (cpmRate / 1000) * 12? Let's check original file.
  // Ah: let monthlyAdRev = freeUsers * (cpmRate / 1000) * 12; in original line 153. Let's make sure it is exactly (cpmRate / 1000) * 12.
  // Wait, let's verify CPM division in our code. Yes, in line 153:
  // const monthlyAdRev = freeUsers * (cpmRate / 1000) * 12;
  // Let's copy it perfectly.
  const totalRevenueSub = subscriptionRev + (freeUsers * (cpmRate / 1000) * 12) + (mau * 0.02);

  // Premium seasonal channels (Santa, Easter Bunny, plus B2B Enterprise syndications like News and Business)
  let enterpriseSaaSRev = 0;
  if (mau >= 3000000) {
    enterpriseSaaSRev = 550000; // Multi-brand accounts
  } else if (mau >= 300000) {
    enterpriseSaaSRev = 40000;
  }

  const totalRevenue = subscriptionRev + (freeUsers * (cpmRate / 1000) * 12) + (mau * 0.02) + enterpriseSaaSRev;

  // Operating expenses (SaaS unit economics)
  const pushNotificationCost = mau * 0.012; 
  const cdnAudioCost = 1500 + (mau * 0.07);
  const cloudInfrastructureCost = 3500 + (mau * 0.022);
  const aiVoiceTtsCost = 250 + (mau * 0.0015);

  let engineeringSlariesCost = 28000;
  let productDesignCost = 5000;
  let marketingCacCost = 10000;
  let legalComplianceCost = 2500;
  let miscellaneousCost = 2000;

  if (mau > 1500000) {
    engineeringSlariesCost = 450000;
    productDesignCost = 75000;
    marketingCacCost = 350000;
    legalComplianceCost = 25000;
    miscellaneousCost = 35000;
  } else if (mau > 150000) {
    engineeringSlariesCost = 110000;
    productDesignCost = 18000;
    marketingCacCost = 75000;
    legalComplianceCost = 8000;
    miscellaneousCost = 6500;
  }

  const stripeFees = (totalRevenue * 0.029) + (paidUsers * 0.30);

  const totalCosts = 
    pushNotificationCost + 
    cdnAudioCost + 
    cloudInfrastructureCost + 
    aiVoiceTtsCost + 
    engineeringSlariesCost + 
    productDesignCost + 
    marketingCacCost + 
    legalComplianceCost + 
    miscellaneousCost + 
    stripeFees;

  const netIncome = totalRevenue - totalCosts;
  const margin = totalRevenue > 0 ? (netIncome / totalRevenue) * 100 : 0;
  const arr = totalRevenue * 12;

  // Approximate break-even calculations
  const approxFixedCost = totalCosts - stripeFees - (mau * 0.02);
  const revPerUser = totalRevenue / mau;
  const breakEvenMAU = revPerUser > 0 ? approxFixedCost / revPerUser : 0;

  // Churn probability
  const baseChurn = 0.040;
  const conversionPenalty = Math.max(0, conversionRate - 5) * 0.0035;
  const premiumCpmBonus = Math.max(0, cpmRate - 5) * 0.0015;
  const churnRateVal = Math.max(0.02, Math.min(baseChurn + conversionPenalty - premiumCpmBonus, 0.12));
  const clvVal = 9.99 / churnRateVal;

  return {
    paidUsers,
    freeUsers,
    subscriptionRev,
    monthlyAdRev: freeUsers * (cpmRate / 1000) * 12,
    creatorAddOnRev: mau * 0.02,
    enterpriseSaaSRev,
    totalRevenue,
    totalCosts,
    netIncome,
    margin,
    arr,
    breakEvenMAU,
    churnProbability: churnRateVal * 100,
    estimatedCLV: clvVal
  };
}

interface CustomTooltipProps {
  active?: boolean;
  payload?: any[];
  label?: string;
}

const CustomTooltip = ({ active, payload, label }: CustomTooltipProps) => {
  if (active && payload && payload.length) {
    const raw = payload[0].payload;
    const isRevenueChart = payload.some(item => 
      ["subRev", "adRev", "saasRev"].includes(item.dataKey)
    );
    const isProjVsActualChart = payload.some(item =>
      ["totalRevenue", "actualRevenue"].includes(item.dataKey)
    );

    return (
      <div className="bg-[#080808] border border-white/10 p-3 shadow-2xl font-mono text-[10px] rounded-none min-w-[210px] backdrop-blur-md">
        {/* Month Title */}
        <p className="text-slate-450 mb-2 border-b border-white/10 pb-1 uppercase tracking-widest text-[9px] font-bold">
          {label}
        </p>
        
        {/* Metric Series rows */}
        <div className="space-y-1.5">
          {payload.map((item: any, idx: number) => {
            let displayValue = "";
            if (item.dataKey === "mauK") {
              displayValue = `${raw.mau.toLocaleString()} active users`;
            } else if (item.dataKey === "subscribersK") {
              displayValue = `${raw.subscribers.toLocaleString()} subscribers`;
            } else if (item.dataKey === "consMauK") {
              displayValue = `${raw.consMau.toLocaleString()} active users (Cons.)`;
            } else if (item.dataKey === "consSubscribersK") {
              displayValue = `${raw.consSubscribers.toLocaleString()} subscribers (Cons.)`;
            } else if (["subRev", "adRev", "saasRev", "totalRevenue", "actualRevenue"].includes(item.dataKey)) {
              displayValue = `$${Math.round(item.value).toLocaleString()}`;
            } else if (item.dataKey === "consTotalRevenue") {
              displayValue = `$${Math.round(item.value).toLocaleString()}`;
            } else {
              displayValue = item.value.toLocaleString();
            }

            return (
              <div key={idx} className="flex justify-between items-center gap-4">
                <span className="text-slate-500 flex items-center gap-1.5">
                  <span className="w-1.5 h-1.5 block" style={{ backgroundColor: item.color }} />
                  {item.name}:
                </span>
                <span className="text-white font-bold font-mono">
                  {displayValue}
                </span>
              </div>
            );
          })}
        </div>

        {/* Dynamic Total Sum row for Multi-Series Revenue chart */}
        {isRevenueChart && raw.totalRevenue && (
          <div className="mt-2.5 pt-1.5 border-t border-[#C19A6B]/20 flex flex-col gap-1">
            <div className="flex justify-between items-center font-bold">
              <span className="text-[#C19A6B] uppercase tracking-wide text-[9px]">Aggressive Total</span>
              <span className="text-white text-[11px] font-mono">${Math.round(raw.totalRevenue).toLocaleString()}</span>
            </div>
            {raw.consTotalRevenue !== undefined && (
              <div className="flex justify-between items-center font-bold border-t border-white/5 pt-1">
                <span className="text-[#F43F5E] uppercase tracking-wide text-[9px]">Conservative Total</span>
                <span className="text-slate-300 text-[10px] font-mono">${Math.round(raw.consTotalRevenue).toLocaleString()}</span>
              </div>
            )}
          </div>
        )}

        {/* Dynamic Variance for Proj vs Actual chart */}
        {isProjVsActualChart && raw.actualRevenue !== undefined && raw.totalRevenue !== undefined && (
          <div className="mt-2.5 pt-1.5 border-t border-white/10 flex flex-col gap-1">
            <div className="flex justify-between items-center font-bold">
              <span className="text-[#C19A6B] uppercase tracking-wide text-[9px]">Execution Variance</span>
              {(() => {
                const diff = raw.actualRevenue - raw.totalRevenue;
                const pct = (diff / raw.totalRevenue) * 100;
                const color = diff >= 0 ? "text-emerald-400" : "text-rose-450";
                const sign = diff >= 0 ? "+" : "";
                return (
                  <span className={`text-[10px] font-mono ${color}`}>
                    {sign}${diff.toLocaleString()} ({sign}{pct.toFixed(1)}%)
                  </span>
                );
              })()}
            </div>
          </div>
        )}
      </div>
    );
  }
  return null;
};

